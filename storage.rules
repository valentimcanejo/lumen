rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // ─── Content packs — read-only for authenticated users ───────────────────
    // Writes are performed exclusively by Cloud Functions (service account).
    match /packs/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // ─── Deny everything else by default ─────────────────────────────────────
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
